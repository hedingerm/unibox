{
  "name": "unibox",
  "version": "0.3.4",
  "description": "Unified desktop inbox for Gmail accounts and Resend domains",
  "main": "./out/main/index.js",
  "author": "Manuel Hedinger",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hedingerm/unibox.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder",
    "release": "bash scripts/release.sh",
    "install:app": "bash scripts/install.sh",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:demo": "esbuild scripts/seed-demo.ts --bundle --platform=node --format=esm --external:better-sqlite3 --outfile=.tmp/seed.mjs --log-level=error && node .tmp/seed.mjs .tmp/demo",
    "smoke": "node scripts/smoke.mjs"
  },
  "trustedDependencies": [
    "better-sqlite3",
    "electron",
    "esbuild"
  ],
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-table": "^3.30.2",
    "@tiptap/extension-text-style": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "better-sqlite3": "^13.0.3",
    "dompurify": "^3.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "react-grab": "^0.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
